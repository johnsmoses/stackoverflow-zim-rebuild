# Environment template for the image worker containers (docker/image-worker).
#
# Copy this file to .env in THIS directory and adjust. NEVER commit real
# values: set these in a local .env (gitignored) — never commit real values.
#
# All values are HOST-side paths. compose.yaml mounts them into the
# container at fixed locations:
#   MANIFEST_DIR  -> /work/manifests  (read-only input)
#   IA_SHARDS_DIR -> /work/ia-shards (read-only input)
#   STATE_DIR     -> /work/state     (writable: SQLite checkpoints)
#   RECOVERED_DIR -> /work/recovered (writable: out-dir/<hash> + results.jsonl)
#
# Relative paths are resolved against the directory containing this file.
# STATE_DIR and RECOVERED_DIR must be writable by uid 10001 (the container
# user); e.g. `chown 10001:10001 state recovered`.

# Directory holding the input manifests (TSV) — mounted READ-ONLY.
MANIFEST_DIR=./manifests

# Directory holding the Archive.org stack-exchange-images ZIP shards — READ-ONLY.
IA_SHARDS_DIR=./ia-shards

# Writable state directory (SQLite resumable checkpoints).
STATE_DIR=./state

# Writable output directory (out-dir/<hash> files + results.jsonl).
RECOVERED_DIR=./recovered
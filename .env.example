# stackoverflow-zim-rebuild environment template
#
# Copy to .env and adjust. Leave derived variables empty to get the
# WORK_ROOT-derived defaults (see docs/configuration.md). bin/common.sh
# sources .env if present and fills in every default. All paths may be
# relative (resolved against the repo root) or absolute.

# --- root of all working data -------------------------------------------
# Stage, output, tmp, cache, redis, mirror, assets all live under here.
WORK_ROOT=./work

# --- derived from WORK_ROOT (defaults shown; leave empty to use them) ---
STAGE_DIR=                # default: ${WORK_ROOT}/stage
OUTPUT_DIR=               # default: ${WORK_ROOT}/out
TMP_DIR=                  # default: ${WORK_ROOT}/tmp
CACHE_DIR=                # default: ${WORK_ROOT}/cache
REDIS_DIR=                # default: ${WORK_ROOT}/redis
REDIS_URL=redis://127.0.0.1:6379/0

# --- sotoki source + virtualenv ------------------------------------------
SOTOKI_SOURCE_DIR=        # default: ${WORK_ROOT}/sotoki-src
SOTOKI_VENV=              # default: ${WORK_ROOT}/.venv-sotoki

# --- StackExchange dump mirror -------------------------------------------
MIRROR_DIR=               # default: ${WORK_ROOT}/mirror
MIRROR_URL=https://archive.org/download/stackexchange
DUMP_ARCHIVE=stackoverflow.com.7z

# --- snapshot identity ----------------------------------------------------
SNAPSHOT_ID=2026-07-06

# --- concurrency ----------------------------------------------------------
THREADS=8
CONTENT_THREADS=4

# --- placeholder handling --------------------------------------------------
PLACEHOLDER_BYTES=1852

# --- archive.org references -----------------------------------------------
IA_ROOT=https://archive.org/download/stackoverflow-final-zim
RECOVERY_ROOT=https://archive.org/download/stackoverflow-images-recovery

# --- image asset cache ------------------------------------------------------
ASSET_CACHE_DIR=          # default: ${WORK_ROOT}/assets
+    def reset_scraper_database(self):
+        """A2: erase the scraper-owned Redis dataset before an incremental rebuild.
+
+        FLUSHDB (never FLUSHALL): the configured logical DB is dedicated to
+        sotoki. --keep-redis only disables the exit-time flush; incremental
+        metadata is rebuilt from an empty dataset regardless.
+        """
+        parsed = urlparse(context.redis_url)
+        if parsed.scheme == "unix":
+            endpoint = parsed.path  # a socket path cannot carry credentials
+            db = "0"
+        else:
+            endpoint = parsed.hostname or parsed.netloc
+            db = parsed.path.strip("/") or "0"
+        logger.info(
+            f"Incremental metadata reset: FLUSHDB on {endpoint} db {db} "
+            "(dedicated sotoki dataset)"
+        )
+        shared.database.safe_command("FLUSHDB")
+

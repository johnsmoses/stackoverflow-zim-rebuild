+# ---------------------------------------------------------------------------
+# 8. prune cross-snapshot
+# ---------------------------------------------------------------------------
+
+
+def test_prune_cross_snapshot(incr_env):
+    stage, fake_db = incr_env
+    _make_v2_page(stage, post_id=1, sha="a" * 64, snapshot="snap-old")
+    _make_v2_page(stage, post_id=2, sha="b" * 64, snapshot="snap-old")
+    fake_db.data[f"snapshot:snap-1:seen"] = {1}
+    scraper = _scraper_harness()
+
+    # without the flag nothing is removed
+    context.prune_missing = False
+    scraper.prune_stale_staged_pages()
+    assert (stage / "html" / "00" / "2").exists()
+
+    # with the flag, page 2 (absent from current snapshot) is pruned, page 1 kept
+    context.prune_missing = True
+    scraper.prune_stale_staged_pages()
+    assert (stage / "html" / "00" / "1").exists()
+    assert not (stage / "html" / "00" / "2").exists()
+
+    # H4: plan journaled before removal, results recorded per item
+    plan = [
+        json.loads(line)
+        for line in (stage / "prune-plan-snap-1.jsonl").read_text().strip().splitlines()
+        if line
+    ]
+    assert len(plan) == 1 and plan[0]["post_id"] == "2"
+    results = [
+        json.loads(line)
+        for line in (stage / "prune-results-snap-1.jsonl")
+        .read_text()
+        .strip()
+        .splitlines()
+        if line
+    ]
+    assert len(results) == 1 and results[0]["status"] == "removed"
+

+def test_rerender_on_change(incr_env, post):
+    stage, fake_db = incr_env
+    page = stage / "html" / "00" / "42"
+    page.mkdir(parents=True)
+    (page / "index.html").write_text("<html>old</html>")
+    (page / "manifest.json").write_text(
+        json.dumps(
+            {
+                "schema_version": 2,
+                "post_id": 42,
+                "source_sha256": "f" * 64,
+                "render_contract_version": RENDER_CONTRACT_VERSION,
+                "snapshot_id": "snap-old",
+            }
+        )
+    )
+    changed = copy.deepcopy(post)
+    changed["Score"] = 77
+    shared.renderer.get_question.return_value = "<html>new version</html>"
+
+    PostGenerator().processor(changed)
+
+    assert (page / "index.html").read_text() == "<html>new version</html>"
+    manifest = json.loads((page / "manifest.json").read_text())
+    assert manifest["schema_version"] == 2
+    assert manifest["source_sha256"] == fingerprint_post(changed)
+    assert manifest["render_contract_version"] == RENDER_CONTRACT_VERSION
+    assert manifest["snapshot_id"] == "snap-1"
+    assert fake_db.data[f"snapshot:snap-1:seen"] == {42}
+    assert fake_db.data["stage:done:questions"] == {42}

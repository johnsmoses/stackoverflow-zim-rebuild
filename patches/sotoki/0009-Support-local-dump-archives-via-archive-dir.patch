+def test_interrupted_no_prune(incr_env):
+    stage, fake_db = incr_env
+    scraper = _scraper_harness()
+    with (
+        patch.object(scraper, "process_tags_metadata"),
+        patch.object(scraper, "process_questions_metadata"),
+        patch.object(scraper, "process_indiv_users_pages"),
+        patch.object(
+            scraper, "process_questions", side_effect=RuntimeError("staging aborted")
+        ),
+        patch.object(scraper, "prune_stale_staged_pages") as m_prune,

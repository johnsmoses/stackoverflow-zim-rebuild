 from zimscraperlib.download import save_large_file, stream_file
 
@@ -27,6 +30,9 @@ class ArchiveManager:
     As this is a lenghty process (several hours for SO) and the output doesn't
     change until next dump (twice a year), this handles reusing existing files"""
 
+    def __init__(self):
+        self._local_archive_copy: Path | None = None
+
     @property
     def dump_parts(self):
         """XML Dump files we're interested in"""
@@ -39,9 +45,36 @@ class ArchiveManager:
         Scraper is capable to download multiple archives per domain. This was used for
         stackoverflow.com which was split with one 7z per dump part. This is not the
         case anymore but scraper capability has not been removed for now.
+
+        With --archive-dir, the selected local dump archive is copied into the
+        build_dir (overwrite) and used instead of downloading (A1). The copy is
+        made once per ArchiveManager instance.
         """
+        if context.archive_dir:
+            local_archive = Path(context.archive_dir) / f"{shared.dump_domain}.7z"
+            if local_archive.exists():
+                if self._local_archive_copy is None:
+                    self._local_archive_copy = self._copy_local_archive_into_build_dir(
+                        local_archive
+                    )
+                return [self._local_archive_copy]
         return [shared.build_dir / f"{shared.dump_domain}.7z"]
 
+    def _copy_local_archive_into_build_dir(self, source: Path) -> Path:
+        """Copy the selected local dump archive into build_dir (overwrite)."""
+        dest = shared.build_dir / source.name
+        logger.info(f"Using local dump archive {source}; copying to {dest}")
+        shutil.copy2(source, dest)
+        return dest
+
+    def _sha256_of(self, fpath: Path) -> str:
+        """SHA-256 of a file, streamed in 1 MiB chunks."""
+        digest = hashlib.sha256()
+        with open(fpath, "rb") as fh:
+            for chunk in iter(lambda: fh.read(1024 * 1024), b""):
+                digest.update(chunk)
+        return digest.hexdigest()
+
     def download_and_extract_archives(self):
         logger.info("Downloading archive(s)…")
 

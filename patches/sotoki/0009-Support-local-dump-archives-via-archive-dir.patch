+#!/usr/bin/env python
+"""Snapshot-aware incremental mode tests (Task 4).
+
+Pure pytest: no redis, no libzim, no network. ``shared.database`` is replaced
+by a dict-backed fake via ``unittest.mock.patch``. Context is initialized by
+``tests/conftest.py``.
+"""
+
+import copy
+import json
+import os
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from sotoki.entrypoint import prepare_context
+from sotoki.posts import (
+    RENDER_CONTRACT_VERSION,
+    PostGenerator,
+    PostsWalker,
+    fingerprint_post,
+    harmonize_post,
+    should_skip_render,

+def _make_v2_page(stage, post_id, sha, snapshot, schema=2, with_html=True):
+    page = stage / "html" / f"{post_id:08x}"[:2] / str(post_id)
+    page.mkdir(parents=True, exist_ok=True)
+    if with_html:
+        (page / "index.html").write_text(f"<p>{post_id}</p>")
+    manifest = {"schema_version": schema, "post_id": post_id}
+    if schema == 2:
+        manifest.update(
+            {
+                "source_sha256": sha,
+                "render_contract_version": RENDER_CONTRACT_VERSION,
+                "snapshot_id": snapshot,
+            }
+        )
+    (page / "manifest.json").write_text(json.dumps(manifest))
+    return page
+

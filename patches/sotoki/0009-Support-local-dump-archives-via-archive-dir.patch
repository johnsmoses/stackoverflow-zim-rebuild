+class FakeDatabase:
+    """Dict-backed stand-in for RedisDatabase used by incremental tests."""
+
+    def __init__(self):
+        self.data = {}
+        self.commands = []
+
+    def safe_command(self, command, *args, **kwargs):
+        self.commands.append((command.upper(), list(args)))
+        cmd = command.upper()
+        if cmd == "SADD":
+            self.data.setdefault(args[0], set()).add(args[1])
+            return 1
+        if cmd == "SMEMBERS":
+            return sorted(self.data.get(args[0], set()))
+        if cmd == "SREM":
+            self.data.get(args[0], set()).discard(args[1])
+            return 1
+        if cmd == "SISMEMBER":
+            return args[1] in self.data.get(args[0], set())
+        if cmd == "DEL":
+            return int(self.data.pop(args[0], None) is not None)
+        if cmd == "FLUSHDB":
+            self.data.clear()
+            return True
+        if cmd == "ZCARD":
+            return len(self.data.get(args[0], set()))
+        if cmd == "ZADD":
+            self.data.setdefault(args[0], set()).add(args[1])
+            return 1
+        raise NotImplementedError(f"FakeDatabase: {cmd} {args}")
+
+    def get_set_count(self, set_name):
+        return len(self.data.get(set_name, set()))
+
+    def zadd(self, name, mapping):
+        return self.safe_command("ZADD", name, mapping)
+
+    def teardown(self):
+        pass
+
+    def remove(self):
+        if not context.keep_redis:
+            self.data.clear()
+
+    def purge(self):
+        pass
+

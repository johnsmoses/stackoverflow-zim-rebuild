+# ---------------------------------------------------------------------------
+# 7. metadata reset (A2 FLUSHDB before metadata passes)
+# ---------------------------------------------------------------------------
+
+
+def test_metadata_reset(incr_env):
+    stage, fake_db = incr_env
+    scraper = _scraper_harness()
+    calls = []
+    with (
+        patch.object(
+            scraper, "process_tags_metadata", side_effect=lambda: calls.append("tags")
+        ),
+        patch.object(
+            scraper,
+            "process_questions_metadata",
+            side_effect=lambda: calls.append("questions"),
+        ),
+        patch.object(
+            scraper, "process_indiv_users_pages", side_effect=lambda: calls.append("users")
+        ),
+        patch.object(
+            scraper,
+            "process_questions",
+            side_effect=lambda: calls.append("questions_pages"),
+        ),
+        patch.object(scraper, "prune_stale_staged_pages"),
+        _shared_fakes(),
+    ):
+        assert scraper.start() is None
+
+    # FLUSHDB is the very first database command (before any metadata pass)
+    assert fake_db.commands and fake_db.commands[0][0] == "FLUSHDB"
+    # metadata passes run in incremental mode and re-record from the dump
+    assert calls == ["tags", "questions", "users", "questions_pages"]

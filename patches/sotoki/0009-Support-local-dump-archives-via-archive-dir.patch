+# 14. concurrent run rejected (H1 lock)
+# ---------------------------------------------------------------------------
+
+
+def test_concurrent_run_rejected(incr_env):
+    stage, fake_db = incr_env
+    generator = PostGenerator()
+    first = generator.acquire_incremental_lock()
+    try:
+        with pytest.raises(RuntimeError, match="concurrent runs are rejected"):
+            generator.acquire_incremental_lock()
+    finally:
+        generator.release_incremental_lock(first)
+    # after release the lock can be acquired again
+    second = generator.acquire_incremental_lock()
+    generator.release_incremental_lock(second)

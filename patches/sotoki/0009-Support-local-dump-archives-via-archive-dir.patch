+def test_unchanged_page_preserved(incr_env, post):
+    stage, fake_db = incr_env
+    fingerprint = fingerprint_post(post)  # harmonize-agnostic
+    page = stage / "html" / "00" / "42"
+    page.mkdir(parents=True)
+    (page / "index.html").write_bytes(b"<html>original bytes</html>")
+    os.utime(page / "index.html", (1234567890, 1234567890))
+    (page / "manifest.json").write_text(
+        json.dumps(
+            {
+                "schema_version": 2,
+                "post_id": 42,
+                "source_sha256": fingerprint,
+                "render_contract_version": RENDER_CONTRACT_VERSION,
+                "snapshot_id": "snap-old",
+            }
+        )
+    )
+    html_before = (page / "index.html").read_bytes()
+    manifest_before = (page / "manifest.json").read_bytes()
+    shared.renderer.get_question.side_effect = AssertionError("must not re-render")
+
+    PostGenerator().processor(copy.deepcopy(post))
+
+    assert (page / "index.html").read_bytes() == html_before
+    assert (page / "manifest.json").read_bytes() == manifest_before
+    assert (page / "index.html").stat().st_mtime_ns == 1234567890_000000000
+    # the page is still recorded in the snapshot seen set so prune keeps it
+    assert fake_db.data[f"snapshot:snap-1:seen"] == {42}
+

+# ---------------------------------------------------------------------------
+# 1. fingerprint stability
+# ---------------------------------------------------------------------------
+
+
+def test_fingerprint_stable(post):
+    harmonize_post(post)
+    fingerprint = fingerprint_post(post)
+    # permute dict key order, answer/comment/link order and tags order
+    permuted = {key: post[key] for key in reversed(list(post))}
+    permuted["answers"] = list(reversed(post["answers"]))
+    permuted["comments"] = list(reversed(post["comments"]))
+    permuted["links"] = {
+        "duplicate": [],
+        "linked": [{"Name": "other question", "Id": 5}],
+    }
+    permuted["Tags"] = ["tag2", "tag1"]
+    assert fingerprint_post(permuted) == fingerprint
+    # a fresh equivalent construction is also identical
+    rebuilt = dict(post)
+    rebuilt["answers"] = [dict(post["answers"][0])]
+    rebuilt["comments"] = [dict(post["comments"][0])]
+    rebuilt["links"] = {"linked": [dict(link) for link in post["links"]["linked"]], "duplicate": []}
+    assert fingerprint_post(rebuilt) == fingerprint
+
+
+# ---------------------------------------------------------------------------
+# 2. fingerprint changes on any contracted edit
+# ---------------------------------------------------------------------------
+
+
+def test_fingerprint_changes_on_edit(post):
+    base = copy.deepcopy(post)
+    harmonize_post(base)
+    base_fingerprint = fingerprint_post(base)
+
+    field_edits = {
+        "title": ("Title", "Different title?"),
+        "body": ("Body", "<p>changed body</p>"),
+        "score": ("Score", 999),
+        "view_count": ("ViewCount", 12345),
+        "last_edit_date": ("LastEditDate", "2021-05-05T00:00:00Z"),
+        "last_editor": ("LastEditorUserId", "111"),
+        "accepted_answer": ("AcceptedAnswerId", "9999"),
+    }
+    for name, (field, value) in field_edits.items():
+        edited = copy.deepcopy(base)
+        edited[field] = value
+        assert fingerprint_post(edited) != base_fingerprint, name
+
+    # accepted answer removed
+    edited = copy.deepcopy(base)
+    edited.pop("AcceptedAnswerId", None)
+    assert fingerprint_post(edited) != base_fingerprint
+
+    # comment Text
+    edited = copy.deepcopy(base)
+    edited["comments"][0]["Text"] = "different comment"
+    assert fingerprint_post(edited) != base_fingerprint
+
+    # answer Body
+    edited = copy.deepcopy(base)
+    edited["answers"][0]["Body"] = "<p>changed answer</p>"
+    assert fingerprint_post(edited) != base_fingerprint
+
+    # link added
+    edited = copy.deepcopy(base)
+    edited["links"]["linked"].append({"Id": 77, "Name": "new link"})
+    assert fingerprint_post(edited) != base_fingerprint
+
+    # link removed
+    edited = copy.deepcopy(base)
+    edited["links"]["linked"] = []
+    assert fingerprint_post(edited) != base_fingerprint
+
+    # a field the renderer does not consume does not change the fingerprint
+    edited = copy.deepcopy(base)
+    edited["FavoriteCount"] = "13"
+    assert fingerprint_post(edited) == base_fingerprint
+

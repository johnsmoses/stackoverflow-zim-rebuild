+def _scraper_harness():
+    """StackExchangeToZim instance without __init__ side effects."""
+    return StackExchangeToZim.__new__(StackExchangeToZim)
+
+
+class _SharedMocks:
+    """Temporarily install attributes on the plain Shared instance.
+
+    patch.object cannot be used: most attributes (database, creator, ...) do
+    not exist on the instance until runtime, and Shared is not a mock.
+    """
+
+    def __init__(self, **mocks):
+        self.mocks = mocks
+        self.old = {}
+
+    def __enter__(self):
+        for name, value in self.mocks.items():
+            self.old[name] = getattr(shared, name, None)
+            setattr(shared, name, value)
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        for name, value in self.old.items():
+            if value is None:
+                if hasattr(shared, name):
+                    delattr(shared, name)
+            else:
+                setattr(shared, name, value)
+        return False
+
+
+def _shared_fakes():
+    """Mock set required to run scraper.start() in staging mode."""
+    return _SharedMocks(
+        creator=MagicMock(),
+        progresser=MagicMock(),
+        executor=MagicMock(),
+        img_executor=MagicMock(),
+        imager=MagicMock(),
+    )
+

+# ---------------------------------------------------------------------------
+# 3. skip decision
+# ---------------------------------------------------------------------------
+
+
+def test_skip_decision(post):
+    harmonize_post(post)
+    fingerprint = fingerprint_post(post)
+    matching = {
+        "schema_version": 2,
+        "post_id": 42,
+        "source_sha256": fingerprint,
+        "render_contract_version": RENDER_CONTRACT_VERSION,
+    }
+    assert should_skip_render(matching, fingerprint) is True
+    # different source digest
+    assert should_skip_render(dict(matching, source_sha256="x" * 64), fingerprint) is False
+    # different render contract version
+    assert (
+        should_skip_render(dict(matching, render_contract_version="2"), fingerprint)
+        is False
+    )
+    # schema_version 1 (legacy full-build manifest)
+    assert should_skip_render(dict(matching, schema_version=1), fingerprint) is False
+    # missing manifest
+    assert should_skip_render(None, fingerprint) is False
+    assert should_skip_render({}, fingerprint) is False
+

From 551397c470a00a8583d453073bf3f25e69c22223 Mon Sep 17 00:00:00 2001
From: johnsmoses <jmoses323@gmail.com>
Date: Sat, 1 Aug 2026 18:13:31 -0400
Subject: [PATCH 4/5] Support offline asset loading and Redis-less tag/user
 fallbacks

---
 src/sotoki/css.py   | 30 ++++++++++++++++++++++++++++--
 src/sotoki/tags.py  | 12 ++++++++++--
 src/sotoki/users.py | 22 +++++++++++++++++++++-
 3 files changed, 59 insertions(+), 5 deletions(-)

diff --git a/src/sotoki/css.py b/src/sotoki/css.py
index 84bdca7..6530769 100644
--- a/src/sotoki/css.py
+++ b/src/sotoki/css.py
@@ -1,4 +1,6 @@
 from io import BytesIO
+from pathlib import Path
+import re
 
 from zimscraperlib.download import stream_file
 from zimscraperlib.rewriting.css import CssRewriter
@@ -16,15 +18,39 @@ from sotoki.utils.shared import shared
 def process_css(online_url: str, filename: str):
     css_zim_path = f"static/css/{filename}"
     dst = BytesIO()
-    stream_file(url=online_url, byte_stream=dst, headers={"User-Agent": USER_AGENT})
+    online_url_str = str(online_url)
+    # Accept local file paths (for offline assembly)
+    if Path(online_url_str).is_file():
+        dst.write(Path(online_url_str).read_bytes())
+        # Use a dummy URL so the CSS rewriter has a valid string to work with
+        rewriter_url = f"https://cdn.sstatic.net/Sites/stackoverflow/{filename}"
+    else:
+        stream_file(url=online_url_str, byte_stream=dst, headers={"User-Agent": USER_AGENT})
+        rewriter_url = online_url_str
     url_rewriter = CssUrlsRewriter(
-        article_url=HttpUrl(online_url),
+        article_url=HttpUrl(rewriter_url),
         article_path=ZimPath(css_zim_path),
     )
     css_rewriter = CssRewriter(
         url_rewriter=url_rewriter, base_href=None, remove_errors=True
     )
     result = css_rewriter.rewrite(content=dst.getvalue())
+    # Kiwix decodes %3F as query separator for CSS asset requests, so paths like
+    # cdn.sstatic.net/Img/unified/sprites.svg%3Fv%3D... are present in zimdump
+    # but still served as 404. Strip cache-busting query fragments from rewritten
+    # Stack static asset URLs and add plain placeholders in scraper.add_assets().
+    if isinstance(result, bytes):
+        result = re.sub(
+            rb"(cdn\.sstatic\.net/Img/[^\"')\\\s]+?)(?:%3Fv%3D|\?v=)[^\"')\\\s]+",
+            rb"\1",
+            result,
+        )
+    else:
+        result = re.sub(
+            r"(cdn\.sstatic\.net/Img/[^\"')\\\s]+?)(?:%3Fv%3D|\?v=)[^\"')\\\s]+",
+            r"\1",
+            result,
+        )
     shared.creator.add_item_for(css_zim_path, content=result, is_front=False)
 
 
diff --git a/src/sotoki/tags.py b/src/sotoki/tags.py
index 3f199bc..3cb7c0d 100644
--- a/src/sotoki/tags.py
+++ b/src/sotoki/tags.py
@@ -112,8 +112,16 @@ class TagGenerator(Generator):
         return shared.build_dir / "Tags.xml"
 
     def run(self):
-        # create individual pages for all tags
-        for tag_name in shared.tagsdatabase.tags_ids.inverse.keys():
+        # create individual pages for all tags. In assemble-only mode the in-memory
+        # tags_ids bidict may be empty even though Redis has the main tags zset.
+        # Fall back to Redis tag names so /questions/tagged/<tag> pages are not 404.
+        tag_names = list(shared.tagsdatabase.tags_ids.inverse.keys())
+        if not tag_names:
+            tag_names = list(
+                shared.database.query_set(shared.tagsdatabase.tags_key(), scored=False)
+            )
+
+        for tag_name in tag_names:
             paginator = SortedSetPaginator(
                 shared.tagsdatabase.tag_key(tag_name),
                 per_page=NB_QUESTIONS_PER_TAG_PAGE,
diff --git a/src/sotoki/users.py b/src/sotoki/users.py
index 053c3af..c1ccbfc 100644
--- a/src/sotoki/users.py
+++ b/src/sotoki/users.py
@@ -3,6 +3,7 @@
 from typing import Any
 
 from slugify import slugify
+from zimscraperlib.typing import Callback
 
 from sotoki.constants import (
     NB_PAGINATED_USERS,
@@ -97,11 +98,30 @@ class UserGenerator(Generator):
                 content=user_page,
                 mimetype="text/html",
                 is_front=True,
+                callbacks=[Callback(func=self.release)],
             )
         del user_page
-        self.release()
 
     def generate_users_page(self):
+        if not hasattr(shared.usersdatabase, "top_users") or not shared.usersdatabase.top_users:
+            logger.warning("No top users to paginate; adding placeholder users index")
+            content = """<!doctype html>
+<html><head><meta charset=\"utf-8\"><title>Users - Stack Overflow</title>
+<link rel=\"stylesheet\" href=\"static/css/stacks.css\"><link rel=\"stylesheet\" href=\"static/css/primary.css\"><link rel=\"stylesheet\" href=\"static/css/secondary.css\"><link rel=\"stylesheet\" href=\"static/css/sotoki.css\"></head>
+<body class=\"users-page\"><div id=\"content\"><div id=\"mainbar-full\">
+<h1 class=\"fs-headline1 mb24\">Users</h1>
+<p>User index unavailable in this offline build.</p>
+<p><a href=\"questions\">Back to questions</a></p>
+</div></div></body></html>"""
+            with shared.lock:
+                shared.creator.add_item_for(
+                    path="users",
+                    content=content,
+                    mimetype="text/html",
+                    title="Users",
+                    is_front=True,
+                )
+            return
         paginator = ListPaginator(
             shared.usersdatabase.top_users,
             per_page=NB_USERS_PER_PAGE,

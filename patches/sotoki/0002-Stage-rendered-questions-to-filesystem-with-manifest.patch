@@ -50,6 +53,84 @@ class PostsDatabase:
     def questions_stats_key():
         return "questions_stats"
 
+    @staticmethod
+    @lru_cache(maxsize=200000)
+    def get_staged_question_fallback(post_id: str) -> dict:
+        """Best-effort metadata fallback from staged manifest/html.
+
+        Assemble-only builds can have Redis score sets but miss Q:/QD: detail keys.
+        Without those keys list pages render as title=None, date=1970, slug=none.
+        Staging contains enough metadata for list pages, so lazily read only the
+        questions actually rendered by paginated home/tag pages.
+        """
+        post_id = str(post_id)
+        try:
+            shard = f"{int(post_id) >> 24:02x}"
+        except Exception:
+            shard = "00"
+        qdir = Path(context.stage_dir) / "html" / shard / post_id
+        manifest_path = qdir / "manifest.json"
+        html_path = qdir / "index.html"
+
+        out = {
+            "title": None,
+            "excerpt": "",
+            "creation_date": datetime.datetime.fromtimestamp(0, datetime.UTC),
+            "owner_user_id": "",
+            "has_accepted": False,
+            "nb_answers": 0,
+            "tags": [],
+        }
+
+        try:
+            manifest = json.loads(manifest_path.read_text())
+            out["title"] = manifest.get("title")
+        except Exception:
+            manifest = {}
+
+        try:
+            html = html_path.read_text(errors="ignore")
+        except Exception:
+            html = ""
+
+        if html:
+            # First paragraph-ish excerpt from rendered question body.
+            m = re.search(r'<div class="s-prose js-post-body"[^>]*>(.*?)</div>', html, re.S)
+            if m:
+                excerpt = re.sub(r"<[^>]+>", " ", m.group(1))
+                excerpt = re.sub(r"\s+", " ", excerpt).strip()
+                out["excerpt"] = excerpt[:250]
+
+            # Main question asked timestamp and owner display/id.
+            m = re.search(
+                r'<time class="s-user-card--time" datetime="asked ([^"]+)">.*?</time>.*?'
+                r'<div class="s-user-card--info">\s*(?:<a [^>]*>)?([^<]+)',
+                html,
+                re.S,
+            )
+            if m:
+                asked, owner = m.group(1).strip(), m.group(2).strip()
+                out["owner_user_id"] = owner
+                for fmt in ("%b %d '%y at %H:%M", "%b %-d '%y at %H:%M"):
+                    try:
+                        out["creation_date"] = datetime.datetime.strptime(asked, fmt).replace(tzinfo=datetime.UTC)
+                        break
+                    except Exception:
+                        pass
+
+            m = re.search(r'itemprop="answerCount">(\d+)</span>', html)
+            if not m:
+                m = re.search(r'data-answercount="(\d+)"', html)
+            if m:
+                out["nb_answers"] = int(m.group(1))
+                out["has_accepted"] = "accepted-answer" in html or "answered-accepted" in html
+
+            tags = re.findall(r'href="\.\./\.\./questions/tagged/([^"]+)"[^>]*class="post-tag', html)
+            if tags:
+                out["tags"] = tags
+
+        return out
+

+    def assemble_zim(self):
+        """Assemble ZIM from staged content in context.stage_dir.
+
+        Walks the staging tree, reads rendered HTML and metadata,
+        adds items to Creator, and finishes the ZIM.
+        List pages (questions, tags, users, about) are generated from Redis state.
+        """
+        stage_root = Path(context.stage_dir)
+        html_root = stage_root / "html"
+
+        if not html_root.exists():
+            logger.error(f"Staging directory not found: {html_root}")
+            return 1
+
+        shared.creator.start()
+
+        try:
+            self.add_illustrations()
+            self.add_assets()
+        except Exception as exc:
+            logger.warning(f"Live asset download failed (continuing): {exc} — can_finish not reset (corruption surfaces explicitly)")
+
+        # Guard: check can_finish remained True after asset loading
+        if not getattr(shared.creator, "can_finish", False):
+            logger.error("can_finish became False during asset loading — ZIM will be empty!")
+            logger.warning("Not resetting can_finish: corruption must surface explicitly at finish()")
+
+        # Walk staging tree and add to ZIM in one pass
+        logger.info("Walking staging tree + adding to ZIM...")
+        total_expected = shared.database.get_set_count(shared.postsdatabase.questions_key()) or 24152540
+        shared.progresser.start(
+            shared.progresser.QUESTIONS_STEP, nb_total=total_expected
+        )
+        total = 0
+        skipped = 0
+        for dirpath, dirs, files in os.walk(str(html_root), topdown=True):
+            if "index.html" not in files:
+                continue
+            html_path = Path(dirpath) / "index.html"
+            stage_dir = html_path.parent
+            try:
+                manifest = json.loads((stage_dir / "manifest.json").read_text())
+                zim_path = manifest["zim_path"]
+                title = manifest["title"]
+                html_content = self.sanitize_staged_html(html_path.read_text())
+            except Exception as exc:
+                logger.debug(f"Skipping staged page {dirpath}: {exc}")
+                skipped += 1
+                continue
+
+            post_id = stage_dir.name
+            safe_title = self.sanitize_zim_title(title, post_id)
+            if safe_title != title:
+                logger.debug(f"Sanitized title for {zim_path}: {title!r} -> {safe_title!r}")
+            with shared.lock:
+                shared.creator.add_item_for(
+                    path=zim_path, title=safe_title,
+                    content=html_content, mimetype="text/html",
+                    # Question pages are the primary articles. Mark them as front
+                    # so Kiwix random article lands on real questions.
+                    is_front=True,
+                )
+                shared.creator.add_redirect(
+                    path=f"questions/{post_id}", target_path=zim_path
+                )
+                for answer_id in manifest.get("answer_redirects", []):
+                    shared.creator.add_redirect(
+                        path=f"a/{answer_id}", target_path=zim_path
+                    )
+            total += 1
+            if total % 100000 == 0:
+                shared.progresser.update(incr=100000)
+                logger.info(f"  Added {total} questions to ZIM...")
+        shared.progresser.update(incr=total % 100000 or 100000)
+        logger.info(f"Added {total} questions to ZIM")
+        if skipped:
+            logger.info(f"Skipped {skipped} unreadable staged pages")
+        if total == 0:
+            logger.error("No questions were added to ZIM — build will be empty!")
+        elif total < 10000000:
+            logger.warning(f"Only {total} questions added (expected ~24M) — staging may be incomplete")
+
+            # Generate list pages from Redis (must have --keep-redis from staging run)
+        # Check Redis score data FIRST (before try block, so we know even if processing fails)
+        try:
+            redis_has_scores = shared.database.get_set_count(
+                shared.postsdatabase.questions_key()
+            ) > 0
+        except Exception:
+            redis_has_scores = False
+
+        try:
+            self.process_tags()
+        except Exception as exc:
+            logger.warning(f"Tag pages generation failed: {exc} (continuing)")
+
+        try:
+            self.process_pages_lists()
+        except Exception as exc:
+            logger.warning(f"List pages generation failed: {exc} (continuing)")
+
+        # Only use staging fallback if Redis score data is missing
+        if not redis_has_scores:
+            try:
+                logger.info("Redis scores missing — generating staging-based questions page...")
+                self.generate_questions_from_staging(stage_root)
+            except Exception as exc2:
+                logger.warning(f"Staging questions list also failed: {exc2}")
+        else:
+            logger.info("Redis scores present — using Redis-generated questions page")
+
+        # Add staged images to ZIM unless building no-pic archive.
+        img_root = stage_root / "images"
+        if context.without_images:
+            logger.info("Skipping staged images (--without-images)")
+        elif img_root.exists():
+            import magic  # python-magic for content-based MIME detection
+            staged_imgs = list(img_root.iterdir())
+            logger.info(f"Adding {len(staged_imgs)} staged images to ZIM")
+            for img_path in staged_imgs:
+                if img_path.suffix == ".tmp" or not img_path.is_file():
+                    continue
+                raw = img_path.read_bytes()
+                mime = magic.from_buffer(raw, mime=True) or "image/jpeg"
+                with shared.lock:
+                    shared.creator.add_item_for(
+                        path=f"images/{img_path.name}",
+                        content=raw,
+                        mimetype=mime,
+                        is_front=False,
+                    )
+
+        logger.info("Finishing ZIM file…")
+        with shared.lock:
+            shared.creator.finish()

+    @staticmethod
+    def sanitize_zim_title(title: str, post_id: str | int) -> str:
+        """Return a title safe for libzim's title indexer.
+
+        A tiny number of Stack Overflow titles contain large runs of invisible
+        Unicode format/control characters. libzim may reject those with
+        "Too much loss of data during title indexing". Retrying after such a
+        failure is unsafe because libzim can partially register the path, so we
+        normalize before add_item_for().
+        """
+        cleaned = unicodedata.normalize("NFKC", str(title or ""))
+        cleaned = "".join(
+            " " if ch.isspace() else ch
+            for ch in cleaned
+            if unicodedata.category(ch) not in {"Cc", "Cf", "Cs"}
+        )
+        cleaned = re.sub(r"\s+", " ", cleaned).strip()
+        if len(cleaned) < 3:
+            return f"Question {post_id}"
+        return cleaned[:500]
+
+    @staticmethod
+    def sanitize_staged_html(html_content: str) -> str:
+        """Repair known bad links produced during staged HTML rewriting.
+
+        Some inline links in posts/comments were rewritten as protocol-relative
+        URLs with a bogus authority, e.g. //:None/../../a/123#123. Browsers treat
+        those as external URLs with host ':None', so they are unusable in Kiwix.
+        The intended target is the relative path after that prefix.
+        """
+        html_content = re.sub(r'((?:href|src)=")//:None/', r'\1', html_content)
+
+        if context.without_images:
+            placeholder = (
+                '<span class="s-notice s-notice__info d-block my8" '
+                'role="note">Image omitted in this no-pic archive.</span>'
+            )
+            # Remove common paragraph-wrapped linked images cleanly.
+            html_content = re.sub(
+                r'<p>\s*<a\b[^>]*>\s*<img\b[^>]*\bsrc="[^"]*/images/[0-9a-f]{16,32}"[^>]*>\s*</a>\s*</p>',
+                f'<p>{placeholder}</p>',
+                html_content,
+                flags=re.I | re.S,
+            )
+            # Remove remaining linked images and standalone in-post images.
+            html_content = re.sub(
+                r'<a\b[^>]*>\s*<img\b[^>]*\bsrc="[^"]*/images/[0-9a-f]{16,32}"[^>]*>\s*</a>',
+                placeholder,
+                html_content,
+                flags=re.I | re.S,
+            )
+            html_content = re.sub(
+                r'<img\b[^>]*\bsrc="[^"]*/images/[0-9a-f]{16,32}"[^>]*>',
+                placeholder,
+                html_content,
+                flags=re.I | re.S,
+            )
+            return html_content
+
+        # If an image is stored in-ZIM, make clicking the image open the local
+        # ZIM image instead of the original CDN URL. The rendered <img src> is
+        # already local; only the surrounding <a href> still points to i.sstatic
+        # / imgur / wikimedia in staged HTML.
+        def _localize_image_anchor(match):
+            before_href, after_href, img_tag, img_src = match.groups()
+            return f'<a{before_href}href="{img_src}"{after_href}>{img_tag}'
+
+        html_content = re.sub(
+            r'<a([^>]*?)href="https?://(?:i\.sstatic\.net|i\.stack\.imgur\.com|[^"/]*imgur\.[^"]+|[^"/]*wikimedia\.[^"]+)[^"]*"([^>]*)>(\s*<img\b[^>]*\bsrc="([^"]*/images/[0-9a-f]{16,32})"[^>]*>)',
+            _localize_image_anchor,
+            html_content,
+            flags=re.I,
+        )
+        return html_content
+

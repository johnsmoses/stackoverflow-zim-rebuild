+<title>Stack Overflow - Questions</title>
+<link rel="stylesheet" href="./static/css/stacks.css">
+</head><body>
+<h1>Stack Overflow Questions</h1>
+<p>{len(items)} questions (newest first)</p>
+<ul>{"".join(links)}</ul>
+</body></html>"""
+
+        with shared.lock:
+            shared.creator.add_item_for(
+                path="questions",
+                content=page_html,
+                mimetype="text/html",
+                title="Highest Voted Questions",
+                is_front=False,
+            )

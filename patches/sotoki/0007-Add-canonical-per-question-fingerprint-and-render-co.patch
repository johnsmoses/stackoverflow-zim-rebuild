+            # H1: exclusive stage-root lock held from seen-set reset through
+            # the optional prune (the scraper prunes while this lock is held).
+            lock_handle = self.acquire_incremental_lock()
+            try:
+                super().run()
+            finally:
+                self.release_incremental_lock(lock_handle)
+        else:
+            super().run()
 

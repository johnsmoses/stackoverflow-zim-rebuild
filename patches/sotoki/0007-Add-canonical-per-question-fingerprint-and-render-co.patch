+_FINGERPRINT_COMMENT_FIELDS = (
+    "Id", "PostId", "UserId", "Score", "Text", "CreationDate", "ContentLicense",
+)
+_FINGERPRINT_ANSWER_FIELDS = (
+    "Id", "Score", "Body", "OwnerUserId", "OwnerDisplayName", "CreationDate",
+    "LastEditDate", "LastEditorUserId",
+)
+
 

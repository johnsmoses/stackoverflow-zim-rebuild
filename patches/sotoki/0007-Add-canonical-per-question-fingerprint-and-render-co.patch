+# Render contract (A4): every field the renderer may consume. Pages are
+# fingerprinted over exactly these fields; anything else is ignored.
+_FINGERPRINT_QUESTION_FIELDS = (
+    "Id", "Title", "Body", "Score", "Tags", "OwnerUserId", "OwnerDisplayName",
+    "CreationDate", "LastActivityDate", "ViewCount", "LastEditDate",
+    "LastEditorUserId", "AcceptedAnswerId",

+def _normalize_tags(tags: Any):
+    """Normalize Tags (raw dump string or post-harmonize list) to a sorted list."""
+    if tags is None:
+        return None
+    if isinstance(tags, str):
+        if len(tags) >= 2 and tags[0] in "<|" and tags[-1] in ">|":
+            tags = re.split(r"\||><", tags[1:-1])
+        else:
+            tags = tags.split("|")
+    return sorted(str(tag) for tag in tags)
+
+
+def _fingerprint_comment(comment: dict) -> dict:
+    return {field: comment.get(field) for field in _FINGERPRINT_COMMENT_FIELDS}
+
+
+def _fingerprint_answer(answer: dict) -> dict:
+    fingerprint = {field: answer.get(field) for field in _FINGERPRINT_ANSWER_FIELDS}
+    fingerprint["comments"] = [
+        _fingerprint_comment(comment)
+        for comment in sorted(
+            answer.get("comments") or [], key=lambda c: int(c.get("Id") or 0)
+        )
+    ]
+    return fingerprint
+
+
+def fingerprint_post(post: dict) -> str:
+    """Canonical SHA-256 over every renderer-consumed field (render contract).
+
+    Permutation-invariant: answers/comments/links are sorted by Id, Tags are
+    sorted, and json keys are sorted. Any change in a contracted field changes
+    the digest; fields the renderer does not consume are ignored (A4).
+    """
+    data = {field: post.get(field) for field in _FINGERPRINT_QUESTION_FIELDS}
+    data["Tags"] = _normalize_tags(data["Tags"])
+    data["comments"] = [
+        _fingerprint_comment(comment)
+        for comment in sorted(
+            post.get("comments") or [], key=lambda c: int(c.get("Id") or 0)
+        )
+    ]
+    data["answers"] = [
+        _fingerprint_answer(answer)
+        for answer in sorted(
+            post.get("answers") or [], key=lambda a: int(a.get("Id") or 0)
+        )
+    ]
+    links = post.get("links") or {}
+    all_links = list(links.get("linked") or []) + list(links.get("duplicate") or [])
+    data["links"] = [
+        dict(sorted(link.items()))
+        for link in sorted(all_links, key=lambda link: int(link.get("Id") or 0))
+    ]
+    canonical = json.dumps(
+        data, sort_keys=True, separators=(",", ":"), ensure_ascii=False, default=str
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+def should_skip_render(existing_manifest, fingerprint: str) -> bool:
+    """Pure decision helper: skip re-render when contract and source match."""
+    if not isinstance(existing_manifest, dict):
+        return False
+    if existing_manifest.get("schema_version") != 2:
+        return False
+    if existing_manifest.get("render_contract_version") != RENDER_CONTRACT_VERSION:
+        return False
+    return existing_manifest.get("source_sha256") == fingerprint
+

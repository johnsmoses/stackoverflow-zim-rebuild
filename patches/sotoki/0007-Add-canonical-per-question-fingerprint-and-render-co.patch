+    def acquire_incremental_lock(self):
+        """H1: exclusive stage-root lock; reject concurrent incremental runs.
+
+        Uses flock on stage_root/.incremental.lock on POSIX (with pid recorded)
+        and an O_EXCL pid lockfile elsewhere.
+        """
+        stage_root = Path(context.stage_dir)
+        stage_root.mkdir(parents=True, exist_ok=True)
+        lock_path = stage_root / ".incremental.lock"
+        if os.name == "posix":
+            import fcntl
+
+            lock_handle = open(lock_path, "a+")
+            try:
+                fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except OSError as exc:
+                lock_handle.close()
+                raise RuntimeError(
+                    f"Another incremental run holds {lock_path}; "
+                    "concurrent runs are rejected"
+                ) from exc
+            lock_handle.seek(0)
+            lock_handle.truncate()
+            lock_handle.write(f"{os.getpid()}\n")
+            lock_handle.flush()
+            return lock_handle
+        # portable fallback: O_EXCL lockfile carrying the pid
+        try:
+            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+        except FileExistsError as exc:
+            raise RuntimeError(
+                f"Another incremental run holds {lock_path}; "
+                "concurrent runs are rejected"
+            ) from exc
+        os.write(fd, f"{os.getpid()}\n".encode())
+        return fd
+
+    def release_incremental_lock(self, lock_handle):
+        """H1: release the stage-root lock acquired by acquire_incremental_lock."""
+        if lock_handle is None:
+            return
+        if os.name == "posix":
+            import fcntl
+
+            try:
+                fcntl.flock(lock_handle, fcntl.LOCK_UN)
+            finally:
+                lock_handle.close()
+        else:
+            os.close(lock_handle)
+            try:
+                (Path(context.stage_dir) / ".incremental.lock").unlink()
+            except OSError:
+                pass
+
     def run(self):
+        PostGenerator.failures = 0
         # On resume: load already-completed question IDs from Valkey
         if context.resume and context.stage_dir:
             done = shared.database.safe_command("SMEMBERS", "stage:done:questions")
@@ -301,7 +456,22 @@ class PostGenerator(Generator):

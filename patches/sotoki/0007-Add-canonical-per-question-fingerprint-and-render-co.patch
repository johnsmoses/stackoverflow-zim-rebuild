+    def _stage_incremental(self, post, post_id, path, stage_path):
+        """Snapshot-aware staging: skip unchanged pages, else render + manifest v2."""
+        fingerprint = fingerprint_post(post)
+        manifest_path = stage_path / "manifest.json"
+        existing_manifest = None
+        if manifest_path.exists():
+            try:
+                existing_manifest = json.loads(manifest_path.read_text())
+            except Exception:
+                existing_manifest = None
+        if should_skip_render(existing_manifest, fingerprint) and (
+            stage_path / "index.html"
+        ).exists():
+            # unchanged: leave bytes and mtime untouched, no manifest rewrite.
+            # Still record the page in this snapshot's seen set so the prune
+            # pass (H2/H3) keeps it.
+            logger.debug(f"Unchanged question {post_id} — skipping re-render")
+            shared.database.safe_command(
+                "SADD", f"snapshot:{context.snapshot_id}:seen", post_id
+            )
+            return
+
+        try:
+            post_page = shared.renderer.get_question(post)
+
+            # Render redirect info for answers
+            answer_redirects = []
+            for answer in post.get("answers", []):
+                answer_redirects.append(str(answer["Id"]))
+
+            # Atomic write: HTML first, then manifest
+            html_tmp = stage_path / ".index.html.tmp"
+            html_tmp.write_text(post_page)
+            html_tmp.rename(stage_path / "index.html")
+
+            manifest = {
+                "schema_version": 2,
+                "post_id": post_id,
+                "source_sha256": fingerprint,
+                "render_contract_version": RENDER_CONTRACT_VERSION,
+                "snapshot_id": context.snapshot_id,
+                "zim_path": path,
+                "title": shared.rewriter.rewrite_string(post.get("Title") or ""),
+                "answer_redirects": answer_redirects,
+                "rendered_at": datetime.datetime.now(datetime.UTC).isoformat(),
+                "tool_version": "sotoki-3.0.2-patched",
+            }
+            manifest_tmp = stage_path / ".manifest.json.tmp"
+            manifest_tmp.write_text(json.dumps(manifest))
+            manifest_tmp.rename(stage_path / "manifest.json")
+
+            # Mark seen in this snapshot + done in the stage checkpoint
+            shared.database.safe_command(
+                "SADD", f"snapshot:{context.snapshot_id}:seen", post_id
+            )
+            shared.database.safe_command("SADD", "stage:done:questions", post_id)
+            del post_page
+        except Exception:
+            # H2: track item failures; prune requires zero failures
+            with PostGenerator.failures_lock:
+                PostGenerator.failures += 1
+            raise
+
